# Copy this file to .env and fill in your Firebase project values.
# Get these from: Firebase Console → Project Settings → Your apps → Web app → SDK setup

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# The Gemini API key is injected by the execution environment at runtime.
# For local development, set it here:
VITE_GEMINI_API_KEY=your_gemini_api_key_here
